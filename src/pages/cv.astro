---
import Layout from '../layouts/Layout.astro';
import TimeLineElement from '../components/TimeLine.astro';
import { createStagger } from '../lib/animations';

const stagger = createStagger();

interface Certification {
  title: string;
  issuer: string;
  url: string;
  // Individual course certificates of a specialization, shown as badges in a full-width card
  courses?: { title: string; url: string }[];
}

const certifications: Certification[] = [
  {
    title: 'AI Engineer Core Track: LLM Engineering, RAG, QLoRA, Agents',
    issuer: 'Udemy',
    url: 'https://www.udemy.com/certificate/UC-721a921b-8a65-4cb1-90e6-0b80bf1b05ba/',
  },
  {
    title: 'English B2 - Integrated Skills in English (ISE II)',
    issuer: 'Trinity College London',
    url: 'https://certificates.trinitycollege.com/4279c030-8a3d-4bd3-aef7-71bc221c90b9#acc.bum8LGOp/',
  },
  {
    title: 'PyTorch for Deep Learning Bootcamp',
    issuer: 'Udemy',
    url: 'https://www.udemy.com/certificate/UC-98e5829d-5b08-47a5-8a8d-83f4ab87b43f/',
  },
  {
    title: 'AWS Educate Introduction to Cloud 101',
    issuer: 'Amazon Web Services',
    url: 'https://www.credly.com/badges/64a57f33-9206-47f5-b475-102a1c75cbde?source=linked_in_profile',
  },
  {
    title: 'Deep Learning Specialization',
    issuer: 'Coursera',
    url: 'https://www.coursera.org/account/accomplishments/specialization/NZDFB6XZ5JBQ',
    courses: [
      { title: 'Convolutional Neural Networks', url: 'https://www.coursera.org/account/accomplishments/verify/76KE486TD96P' },
      { title: 'Sequence Models', url: 'https://www.coursera.org/account/accomplishments/verify/C5XQXDRVV2X7' },
      { title: 'Improving Deep Neural Networks: Hyperparameter Tuning, Regularization and Optimization', url: 'https://www.coursera.org/account/accomplishments/verify/AG92H89GH2DZ' },
      { title: 'Neural Networks and Deep Learning', url: 'https://www.coursera.org/account/accomplishments/verify/FATPV3RVDFBD' },
      { title: 'Structuring Machine Learning Projects', url: 'https://www.coursera.org/account/accomplishments/verify/WY6DAPUDXBKA' },
    ],
  },
];
---
<Layout title="CV | Miguel Antunes García" sideBarActiveItemID="cv">

  <div class:list={["mb-5", stagger()]}>
    <div class="text-3xl w-full font-bold">Education</div>
  </div>

  <!-- Education -->
  <div class:list={["time-line-container grid gap-5 mb-10", stagger()]}>

    <TimeLineElement
      title="Ph.D. in Advanced Electronics and Intelligent Systems"
      subtitle="Since 2023 at University of Alcalá, Spain"
      >
      <ul>
        <li>Advisors: <a href="https://scholar.google.es/citations?user=uEBILewAAAAJ" class="text-link">Luis M. Bergasa</a> and <a href="https://scholar.google.es/citations?user=IktmiSAAAAAJ" class="text-link">Rafael Barea</a>.</li>
        <li>Thesis with title <i><b>Deep Learning for Unified Perception and Prediction in Autonomous Driving.</b></i></li>
        <li>Internship at <a href="https://iv.ee.hm.edu/" class="text-link">Intelligent Vehicles Lab, Hochschule München</a> under the supervision of <a href="https://www.linkedin.com/in/fabian-flohr-a99031115/" class="text-link">Prof. Dr. Fabian Flohr</a>.</li>
      </ul>
    </TimeLineElement>

    <TimeLineElement
      title="M.Sc. in Telecommunications Engineering"
      subtitle="2021 to 2023 at University of Alcalá, Spain"
      >
      <ul>
        <li>Specialization in <b>Space and Defense Technologies.</b></li>
        <li>Final Thesis with title <i><b>Study of Camera-based Systems for Three-dimensional Object Detection in Autonomous Driving.</b></i></li>
      </ul>
    </TimeLineElement>

    <TimeLineElement
      title="B.Sc. in Electronic and Communications"
      subtitle="2017 to 2021 at University of Alcalá, Spain"
      >
      <ul>
        <li>Final Thesis with title <i><b>Stereo Vision System Applied to Detection and 
          Tracking of Objects in Autonomous Driving.</b></i></li>
      </ul>
    </TimeLineElement>

  </div>

  <div class:list={["mb-5", stagger()]}>
    <div class="text-3xl w-full font-bold">Experience</div>
  </div>

  <!-- Experience -->
  <div class:list={["time-line-container grid gap-5 mb-10", stagger()]}>

    <TimeLineElement
      title="Predoctoral Researcher"
      subtitle="Since May 2024 at RobeSafe, Department of Electronics, University of Alcalá."
    >
    <ul>
      <li>Artificial Intelligence for Perception and Prediction in Autonomous Driving.</li>
      <li>Teaching assistance and student supervision.</li>
    </ul> 
    </TimeLineElement>

    <TimeLineElement
      title="Research Internship"
      subtitle="From March 2026 to May 2026 at Intelligent Vehicles Lab, Hochschule München, Germany"
    >
    </TimeLineElement>

    <TimeLineElement
      title="Research Staff"
      subtitle="From January 2023 to April 2024 at RobeSafe, Department of Electronics, University of Alcalá."
    >
    <ul>
      <li>3D Perception for Autonomous Vehicles using Stereo Cameras.</li>
    </ul> 
    </TimeLineElement>

    <TimeLineElement
      title="Engineering Intern"
      subtitle="From November 2022 to December 2022 at Escribano Mechanical and Engineering, Alcalá de Henares, Spain"
    >
    <ul>
      <li>Artificial Intelligence for Road Anomaly Detection in Military Vehicles.</li>
    </ul> 
    </TimeLineElement>

    <TimeLineElement
      title="Research Staff"
      subtitle="From January 2020 to October 2022 at RobeSafe, Department of Electronics, University of Alcalá."
    >
    <ul>
      <li>Camera-based Perception and Creation of Simulation Environments for Autonomous Driving.</li>
    </ul> 
    </TimeLineElement>

  </div>

  <div class:list={["mb-5", stagger()]}>
    <div class="text-3xl w-full font-bold">Certifications</div>
  </div>

  <ul class="grid gap-4 md:grid-cols-2 mb-10">
    {certifications.map((certification) => (
      <li class:list={[certification.courses && "md:col-span-2", stagger()]}>
        <div class="h-full rounded-xl bg-base-200 transition ease-in-out hover:shadow-xl hover:bg-base-300">
          <a href={certification.url} target="_blank" rel="noopener noreferrer" class="group flex items-start gap-3 p-4">
            <div class="grow">
              <p class="text-xs font-semibold uppercase tracking-wide text-accent">{certification.issuer}</p>
              <h3 class="font-semibold mt-1 group-hover:text-accent transition-colors">{certification.title}</h3>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" class="size-5 shrink-0 mt-1 text-base-content/50 transition group-hover:text-accent group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 19.5 15-15m0 0H8.25m11.25 0v11.25" />
            </svg>
          </a>
          {certification.courses && (
            <ul class="flex flex-wrap gap-2 px-4 pb-4">
              {certification.courses.map((course) => (
                <li>
                  <a href={course.url} target="_blank" rel="noopener noreferrer" class="badge badge-outline h-auto py-1 text-left transition-colors hover:border-accent hover:text-accent">
                    {course.title}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      </li>
    ))}
  </ul>
</Layout>
