---
import Layout from '../layouts/Layout.astro';
import PublicationCard from '../components/PublicationCard.astro';
import { getPublications } from '../lib/publications';
import { createStagger } from '../lib/animations';

const publications = await getPublications();
const sections = [
    { title: 'Preprints', items: publications.filter((p) => p.kind === 'preprint') },
    { title: 'Journal Publications', items: publications.filter((p) => p.kind === 'journal') },
    { title: 'Conference Publications', items: publications.filter((p) => p.kind === 'conference') },
];
const stagger = createStagger();
---
<Layout title="Publications | Miguel Antunes García" sideBarActiveItemID="publications">
	<section aria-label="Publications">
        <div class="pb-12 mt-5">
            <div class:list={["text-3xl font-bold pb-5", stagger()]}>Publications</div>
            {sections.filter((section) => section.items.length > 0).map((section) => (
                <>
                    <h2 class:list={["text-2xl font-bold pt-6 pb-3", stagger()]}>{section.title}</h2>
                    {section.items.map((publication) => <PublicationCard publication={publication} class={stagger()} />)}
                </>
            ))}
        </div>
	</section>
</Layout>
