---
import Layout from '../layouts/Layout.astro';

import { getCollection } from 'astro:content';
import { createStagger } from '../lib/animations';

// Newest first, periods look like 2025-2026
const undergrad_projects = (await getCollection('undergrad_projects')).sort((a, b) => b.data.period.localeCompare(a.data.period));
const undergrad_subjects = await getCollection('undergrad_subjects');
const grad_subjects = await getCollection('grad_subjects');
const stagger = createStagger();

const sections = [
    {
        heading: 'Undergraduate Academic Subjects',
        items: undergrad_subjects.map(({ data }) => ({ ...data, meta: `${data.institution} | ${data.period}` })),
    },
    {
        heading: 'Undergraduate Projects',
        items: undergrad_projects.map(({ data }) => ({ ...data, meta: `${data.student} | ${data.period}` })),
    },
    {
        heading: 'Graduate Academic Subjects',
        items: grad_subjects.map(({ data }) => ({ ...data, meta: `${data.institution} | ${data.period}` })),
    },
];
---
<Layout title="Teaching | Miguel Antunes García" sideBarActiveItemID="teaching">
    <section aria-label="Teaching">
        <div class="pb-12 mt-5">
            {sections.map((section) => (
                <div class="mb-10">
                    <h2 class:list={["text-3xl font-bold pb-5", stagger()]}>{section.heading}</h2>
                    {section.items.map((item) => (
                        <div class:list={["bg-base-200 rounded-xl p-4 mb-4", stagger()]}>
                            <h3 class="text-lg font-bold">{item.title}</h3>
                            <p class="text-sm text-base-content/70 italic mt-1">{item.meta}</p>
                            <p class="text-sm text-base-content/80 mt-2">{item.description}</p>
                        </div>
                    ))}
                </div>
            ))}
        </div>
    </section>
</Layout>
