---
import Layout from '../layouts/Layout.astro';

import { getCollection } from 'astro:content';
import { createStagger } from '../lib/animations';

// Newest first, periods look like 2025-2026
const undergrad_projects = (await getCollection('undergrad_projects')).sort((a, b) => b.data.period.localeCompare(a.data.period));
const undergrad_subjects = await getCollection('undergrad_subjects');
const grad_subjects = await getCollection('grad_subjects');
const stagger = createStagger();
---
<Layout title="Teaching | Miguel Antunes García" sideBarActiveItemID="teaching">
    <section aria-label="Teaching">
        <div class="pb-12 mt-5">
            <!-- Undergraduate -->
            <!-- Academic Subjects -->
            <div class="mb-12">
            <h2 class:list={["text-3xl font-bold pb-5", stagger()]}>Undergraduate Academic Subjects</h2>
            {undergrad_subjects.map((subject) => (
                <div class:list={["bg-base-200 rounded-xl p-6 mb-6 shadow-lg", stagger()]}>
                <div class="flex flex-col md:flex-row gap-4 mb-4">
                    <div class="flex-grow">
                    <h3 class="text-2xl font-bold">{subject.data.title}</h3>
                    <p class="text-sm text-base-content/70 mt-1">
                        {subject.data.institution} | {subject.data.period}
                    </p>
                    </div>
                    <div class="flex-shrink-0 mt-2">
                        <span class="badge badge-accent">{subject.data.status}</span>
                    </div>
                </div>
                <p class="mb-4 text-base-content/80">{subject.data.description}</p>
                </div>
            ))}
            </div>

            <!-- Projects -->
            <div class="mb-12">
                <h2 class:list={["text-3xl font-bold pb-5", stagger()]}>Undergraduate Projects</h2>
                {undergrad_projects.map((project) => (
                    <div class:list={["bg-base-200 rounded-xl p-6 mb-6 shadow-lg", stagger()]}>
                        <div class="flex flex-col md:flex-row gap-4 mb-4">
                            <div class="flex-grow">
                                <h3 class="text-2xl font-bold">{project.data.title}</h3>
                                <p class="text-sm text-base-content/70 mt-1">
                                    {project.data.student} | {project.data.period}
                                </p>
                            </div>
                            <div class="flex-shrink-0 mt-2">
                                <span class="badge badge-accent">{project.data.status}</span>
                            </div>
                        </div>
                        <p class="mb-4 text-base-content/80">{project.data.description}</p>
                    </div>
                ))}
            </div>

            <!-- Graduate -->
            <div class="mb-12">
            <h2 class:list={["text-3xl font-bold pb-5", stagger()]}>Graduate Academic Subjects</h2>
            {grad_subjects.map((subject) => (
                <div class:list={["bg-base-200 rounded-xl p-6 mb-6 shadow-lg", stagger()]}>
                    <div class="flex flex-col md:flex-row gap-4 mb-4">
                        <div class="flex-grow">
                            <h3 class="text-2xl font-bold">{subject.data.title}</h3>
                            <p class="text-sm text-base-content/70 mt-1">
                                {subject.data.institution} | {subject.data.period}
                            </p>
                        </div>
                        <div class="flex-shrink-0 mt-2">
                            <span class="badge badge-accent">{subject.data.status}</span>
                        </div>
                    </div>
                    <p class="mb-4 text-base-content/80">{subject.data.description}</p>
                </div>
            ))}
            </div>

        </div>
    </section>
</Layout>