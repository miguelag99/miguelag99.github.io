---
import type { ImageMetadata } from "astro";
import gitLogo from "../assets/logos/git.svg";
import bashLogo from "../assets/logos/bash.svg";
import dockerLogo from "../assets/logos/docker.svg";
import vscodeLogo from "../assets/logos/vscode.svg";
import pythonLogo from "../assets/logos/python.svg";
import pytorchLogo from "../assets/logos/pytorch.svg";
import awsLogo from "../assets/logos/aws.svg";
import rosLogo from "../assets/logos/ros.svg";

interface Technology {
  name: string;
  logo: ImageMetadata;
  url: string;
}

const technologies: Technology[] = [
  { name: "Git", logo: gitLogo, url: "https://git-scm.com/" },
  { name: "Bash", logo: bashLogo, url: "https://www.gnu.org/software/bash/" },
  { name: "Docker", logo: dockerLogo, url: "https://www.docker.com/" },
  { name: "Visual Studio Code", logo: vscodeLogo, url: "https://code.visualstudio.com/" },
  { name: "Python", logo: pythonLogo, url: "https://www.python.org/" },
  { name: "PyTorch", logo: pytorchLogo, url: "https://pytorch.org/" },
  { name: "Amazon Web Services", logo: awsLogo, url: "https://aws.amazon.com/" },
  { name: "ROS", logo: rosLogo, url: "https://www.ros.org/" },
];
---

<div class="relative overflow-x-hidden py-8">
  <div class="pointer-events-none absolute inset-y-0 left-0 w-32 bg-gradient-to-r from-base-100 to-transparent z-20"></div>
  <div class="pointer-events-none absolute inset-y-0 right-0 w-32 bg-gradient-to-l from-base-100 to-transparent z-20"></div>

  <div class="flex animate-scroll hover:animate-paused w-max">
    {
      // Two identical copies (spacing via padding, not gap) so the -50% translation loops seamlessly
      [0, 1].map((copy) =>
        technologies.map((tech) => (
          <a
            href={tech.url}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 pr-12 group"
            aria-hidden={copy > 0 ? "true" : undefined}
            tabindex={copy > 0 ? -1 : undefined}
          >
            <img
              src={tech.logo.src}
              alt=""
              class="h-7 w-auto object-contain transition-transform group-hover:scale-110"
              width="35"
              height="35"
              loading="lazy"
            />
            <span class="text-lg font-medium text-base-content">{tech.name}</span>
          </a>
        ))
      )
    }
  </div>
</div>

<style is:global>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  .animate-scroll {
    animation: scroll 40s linear infinite;
  }
  .hover\:animate-paused:hover {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-scroll {
      animation: none;
    }
  }
</style>
