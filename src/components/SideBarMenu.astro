---
const { sideBarActiveItemID } = Astro.props;

// Icon paths from Heroicons (24x24, outline)
const items = [
    {
        id: "home",
        label: "Home",
        href: "/",
        icon: "m2.25 12 8.954-8.955a1.126 1.126 0 0 1 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25",
    },
    {
        id: "cv",
        label: "CV",
        href: "/cv",
        icon: "M15 9h3.75M15 12h3.75M15 15h3.75M4.5 19.5h15a2.25 2.25 0 0 0 2.25-2.25V6.75A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25v10.5A2.25 2.25 0 0 0 4.5 19.5Zm6-10.125a1.875 1.875 0 1 1-3.75 0 1.875 1.875 0 0 1 3.75 0Zm1.294 6.336a6.721 6.721 0 0 1-3.17.789 6.721 6.721 0 0 1-3.168-.789 3.376 3.376 0 0 1 6.338 0Z",
    },
    {
        id: "publications",
        label: "Publications",
        href: "/publications",
        icon: "M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z",
    },
    {
        id: "teaching",
        label: "Teaching",
        href: "/teaching",
        icon: "M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-7.007 11.55A5.981 5.981 0 0 0 6.75 15.75v-1.5",
    },
];
---

<nav aria-label="Main" class="grow shrink overflow-y-auto px-2">
    <ul class="flex flex-col gap-1">
        {
            items.map((item) => {
                const active = item.id === sideBarActiveItemID;
                return (
                    <li>
                        <a
                            id={item.id}
                            href={item.href}
                            aria-current={active ? "page" : undefined}
                            class:list={[
                                "group relative flex items-center gap-3 rounded-lg px-4 py-3 text-base transition-colors duration-200",
                                "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent",
                                active
                                    ? "bg-base-300 font-semibold text-base-content"
                                    : "text-base-content/70 hover:bg-base-300/60 hover:text-base-content",
                            ]}
                        >
                            <span
                                class:list={[
                                    "absolute left-0 top-1/2 w-1 -translate-y-1/2 rounded-full bg-accent transition-all duration-200",
                                    active ? "h-6 opacity-100" : "h-0 opacity-0 group-hover:h-3 group-hover:opacity-60",
                                ]}
                            />
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke-width="1.5"
                                stroke="currentColor"
                                aria-hidden="true"
                                class:list={[
                                    "size-5 shrink-0 transition-colors duration-200",
                                    active ? "text-accent" : "group-hover:text-accent",
                                ]}
                            >
                                <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
                            </svg>
                            {item.label}
                        </a>
                    </li>
                );
            })
        }
    </ul>
</nav>
